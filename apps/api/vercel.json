{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --workspaces=false --include=dev --no-audit --no-fund",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/**",
      "maxDuration": 15
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
